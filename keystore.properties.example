# Copia este archivo a keystore.properties (ignorado por git) y rellénalo.
# Sin él, assembleRelease genera una APK sin firmar que no sirve como
# actualización: Android identifica una app por applicationId + firma.
storeFile=C:/ruta/absoluta/a/smartcount-release.jks
storePassword=
keyAlias=smartcount
